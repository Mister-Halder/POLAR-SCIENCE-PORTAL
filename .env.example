# India Polar Science Portal — example environment. Never commit real values.

# Frontend (exposed to the browser)
VITE_APP_NAME="India Polar Science Portal"
VITE_PUBLIC_API_BASE="/api/v1"

# Server-only (read inside server function handlers / Express API)
POLAR_API_URL="http://localhost:4000"
DATABASE_URL="postgres://polar:change-me@localhost:5432/polar"
JWT_ACCESS_SECRET=""      # 64+ random chars, rotate quarterly
JWT_REFRESH_SECRET=""     # distinct from the access secret
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# Search
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_SEARCH_KEY=""   # search-only key, safe for server-side proxying
MEILISEARCH_ADMIN_KEY=""    # indexing only, API container

# Object storage (S3-compatible: AWS S3, MinIO, Wasabi)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="ap-south-1"
S3_BUCKET="polar-datasets"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PRESIGN_TTL_SECONDS="300"

# DOI minting and mail
DATACITE_REPOSITORY_ID=""
DATACITE_PASSWORD=""
SMTP_URL=""
